{
  "name": "pokedex",
  "version": "1.0.0",
  "description": "A REST Api for pokedex data",
  "author": "Cory Hedges",
  "license": "ISC",
  "babel": {
    "presets": [
      "@babel/preset-env"
    ],
    "plugins": [
      "@babel/proposal-class-properties",
      "@babel/plugin-transform-runtime"
    ]
  },
  "nodemonConfig": {
    "exec": "npm run dev",
    "watch": [
      "server/*"
    ],
    "ignore": [
      "*.test.js",
      "*.spec.js"
    ]
  },
  "scripts": {
    "start": "npm run prod",
    "build": "npm-run-all clean transpile",
    "server": "node ./dist-server/app",
    "dev": "set NODE_ENV=development& npm-run-all build server",
    "prod": "set NODE_ENV=production& npm-run-all build server",
    "transpile": "babel ./server --out-dir dist-server",
    "clean": "rimraf dist-server",
    "watch:dev": "nodemon"
  },
  "dependencies": {
    "@babel/cli": "^7.13.0",
    "@babel/core": "^7.13.8",
    "@babel/preset-env": "^7.13.8",
    "@babel/runtime": "^7.13.10",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "lodash": "^4.17.21",
    "nodemon": "^2.0.7",
    "pg": "^8.0.2",
    "rimraf": "^3.0.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.13.10",
    "npm-run-all": "^4.1.5"
  }
}
